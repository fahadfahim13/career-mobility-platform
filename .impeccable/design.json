      "css": ".ds-label{display:block;font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-size:14px;font-weight:600;color:#111;}.ds-input{display:block;margin-top:4px;width:100%;min-height:44px;padding:0 12px;border:1px solid #c5c5bd;border-radius:2px;background:#fff;color:#111;font:inherit;font-weight:400;transition:border-color 150ms;}.ds-input:hover{border-color:#6f6f66;}.ds-input:focus-visible{outline:2px solid #1f3fd1;outline-offset:2px;}.ds-input[aria-invalid=true]{border-color:#c62d26;}"

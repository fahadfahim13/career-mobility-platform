      "css": ".ds-field-band{background:#1f3fd1;padding:24px;display:flex;gap:12px;flex-wrap:wrap;}.ds-btn-onfield{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 16px;border-radius:2px;font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-size:14px;font-weight:600;line-height:20px;border:0;cursor:pointer;transition:background-color 150ms,color 150ms,border-color 150ms;background:#fbfbf9;color:#111;}.ds-btn-onfield:hover{background:#ffd23f;}.ds-btn-onfield-outline{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 16px;border-radius:2px;font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-size:14px;font-weight:600;line-height:20px;border:0;cursor:pointer;transition:background-color 150ms,color 150ms,border-color 150ms;background:transparent;color:#fff;border:1px solid #d3dbfb;}.ds-btn-onfield-outline:hover{background:#172fa3;}.ds-field-band :focus-visible{outline:2px solid #ffd23f;outline-offset:2px;}"

# Optional. Enables resume reading and the AI match summary, via OpenRouter.
# When unset, the app runs in mock mode: the match summary is rule-based and resume upload asks
# the user to fill in the form by hand. Everything else works the same.
OPENROUTER_API_KEY=

# Optional. Any OpenRouter model id for the match summary. Default: anthropic/claude-haiku-5.5
OPENROUTER_MODEL=

# Optional. Model for reading uploaded resumes. Default: google/gemini-2.5-flash-lite
OPENROUTER_RESUME_MODEL=

# Private Vercel Blob store for accounts, applications and uploaded resumes. Set automatically when
# the store is connected to the Vercel project. Without it, the app uses an in-memory store, and all
# accounts, applications and resumes are lost when the server restarts.
BLOB_READ_WRITE_TOKEN=

# Required in production. Secret that signs the session cookie (HMAC-SHA256). At least 32 characters.
# In development a fixed local secret is used when this is unset.
SESSION_SECRET=

# Optional. Set to "memory" to force the in-memory store even when a Blob token is present
# (used for local end-to-end runs).
PATHWAY_STORE=

# Optional. Requests per minute per client for each route family. Default: 20
RATE_LIMIT_PER_MIN=

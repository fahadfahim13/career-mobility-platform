# Optional. Enables resume reading and the AI match summary on the opportunity detail page, via OpenRouter.
# When unset, the app runs in mock mode and uses the rule-based summary. Everything else works the same.
OPENROUTER_API_KEY=

# Optional. Any OpenRouter model id. Default: anthropic/claude-haiku-5.5
OPENROUTER_MODEL=

# Optional. Model for reading uploaded resumes. Default: google/gemini-2.5-flash-lite
OPENROUTER_RESUME_MODEL=

# Optional. Private Vercel Blob store for uploaded resumes. Without it, resumes are read but not kept.
BLOB_READ_WRITE_TOKEN=
